<% content_for :title, "Administrators - ZTLP Directory" %>
<div class="page-head">
  <div><h1>Administrators</h1><p class="lede">Keys that can sign in to this panel.</p></div>
  <% if current_admin.super_admin? %>
    <div class="actions"><%= link_to "Add administrator", new_admin_path, class: "btn primary" %></div>
  <% end %>
</div>
<div class="table-wrap">
  <table>
    <thead><tr><th>Username</th><th>Name</th><th>Email</th><th>Role</th><th>Public key</th><th>Last login</th><th></th></tr></thead>
    <tbody>
    <% @admins.each do |a| %>
      <tr class="<%= "opacity-50" if a.disabled? %>">
        <td class="mono"><%= a.username %><%= " (disabled)" if a.disabled? %></td>
        <td><%= a.display_name %></td>
        <td class="sub"><%= a.email %></td>
        <td><%= a.role.humanize %></td>
        <td class="mono sub" title="<%= a.pubkey_hex %>"><%= a.pubkey_hex[0, 16] %>…</td>
        <td class="sub nowrap"><%= a.last_login_at&.utc&.strftime("%Y-%m-%d %H:%M") || "never" %></td>
        <td class="row-actions">
          <% if current_admin.super_admin? %>
            <% if a != current_admin %>
              <%= form_with url: toggle_admin_path(a), method: :post, class: "inline" do %>
                <input type="hidden" name="disabled" value="<%= a.disabled? ? '0' : '1' %>">
                <button type="submit" class="btn sm" data-admin-toggle="<%= a.id %>"><%= a.disabled? ? "Re-enable" : "Disable" %></button>
              <% end %>
            <% end %>
            <%= link_to "Edit", edit_admin_path(a), class: "btn sm" %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
