<% content_for :title, "Administrators - ZTLP Admin" %>
<div class="flex items-center">
  <h1 class="text-2xl font-semibold">Administrators</h1>
  <% if current_admin.super_admin? %>
    <%= link_to "Add administrator", new_admin_path, class: "ml-auto rounded bg-[#1f5fa8] px-4 py-2 text-sm font-medium text-white hover:bg-[#184b86]" %>
  <% end %>
</div>
<table class="mt-6 w-full text-sm">
  <thead><tr class="border-b text-left text-xs uppercase text-slate-500">
    <th class="py-2 pr-3">Username</th><th class="pr-3">Name</th><th class="pr-3">Email</th><th class="pr-3">Role</th><th class="pr-3">Public key</th><th class="pr-3">Last login</th><th></th>
  </tr></thead>
  <tbody>
  <% @admins.each do |a| %>
    <tr class="border-b <%= "opacity-50" if a.disabled? %>">
      <td class="py-2 pr-3 font-mono"><%= a.username %><%= " (disabled)" if a.disabled? %></td>
      <td class="pr-3"><%= a.display_name %></td>
      <td class="pr-3 text-slate-600"><%= a.email %></td>
      <td class="pr-3"><%= a.role.humanize %></td>
      <td class="pr-3 font-mono text-xs text-slate-600" title="<%= a.pubkey_hex %>"><%= a.pubkey_hex[0, 16] %>…</td>
      <td class="pr-3 text-slate-600 whitespace-nowrap"><%= a.last_login_at&.utc&.strftime("%Y-%m-%d %H:%M") || "never" %></td>
      <td><% if current_admin.super_admin? %><%= link_to "Edit", edit_admin_path(a), class: "text-[#1f5fa8]" %><% end %></td>
    </tr>
  <% end %>
  </tbody>
</table>
