<% content_for :title, "Audit log - ZTLP Admin" %>
<div class="flex items-center gap-4">
  <h1 class="text-2xl font-semibold">Audit log</h1>
  <%= form_with url: audit_logs_path, method: :get, class: "ml-auto flex items-center gap-2 text-sm" do |f| %>
    <%= f.select :action_filter, options_for_select([["All actions", ""]] + @actions.map { |a| [a, a] }, params[:action_filter]), {}, class: "rounded border px-2 py-1", onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>
<%= render "audit_logs/table", logs: @logs %>
