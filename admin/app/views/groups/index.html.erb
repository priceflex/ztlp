<% content_for :title, "Groups - ZTLP Directory" %>
<div class="page-head">
  <div><h1>Groups</h1><p class="lede">Named sets of users. A policy references a group, so membership changes take effect the moment they are published.</p></div>
  <% if current_admin&.write_access? %><div class="actions"><%= link_to "New group", new_group_path, class: "btn primary" %></div><% end %>
</div>

<div class="table-wrap">
  <table>
    <thead><tr><th>Name</th><th>Description</th><th>Members</th><th>Applications</th></tr></thead>
    <tbody>
      <% @groups.each do |g| %>
        <tr data-act="open" data-drawer="<%= group_path(g) %>" tabindex="0">
          <td><div class="who"><div><div class="strong"><a href="<%= group_path(g) %>"><%= g.name %></a></div>
            <div class="sub mono"><%= g.ns_name %></div></div></div></td>
          <td><span class="sub"><%= g.description.presence || "—" %></span></td>
          <td class="nowrap row-members"><%= g.users.count %></td>
          <td class="nowrap"><span class="sub">0</span></td>
        </tr>
      <% end %>
      <% if @groups.empty? %><tr class="empty"><td colspan="4">No groups yet. Add a group to start organizing access.</td></tr><% end %>
    </tbody>
  </table>
</div>
