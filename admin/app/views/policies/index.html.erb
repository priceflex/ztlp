<% content_for :title, "Policies - ZTLP Directory" %>
<div class="page-head">
  <div><h1>Policies</h1><p class="lede">Every service's allow-list, grouped by service. The default is deny; rule changes need a gateway restart, membership changes are live.</p></div>
</div>

<div class="stack">
  <% @gateways.each do |gw| %>
    <% doc = @policy_docs[gw] %>
    <% gw.services.order(:name).each do |app| %>
      <div class="panel">
        <div class="panel-h"><h2><%= app.name %></h2>
          <span class="sub mono"><%= app.ztlp_name %></span>
          <span class="badge <%= app.enabled ? "ok" : "bad" %>"><%= app.enabled ? "enabled" : "disabled" %></span>
          <span class="sub"><%= gw.name %>.<%= gw.zone.name %> (<%= gw.kind %>)</span></div>
        <% if app.policy_rules.any? %>
          <div class="table-wrap"><table>
            <thead><tr><th>#</th><th>Subject type</th><th>Rendered literal</th></tr></thead>
            <tbody>
              <% app.policy_rules.order(:position, :id).each do |rule| %>
                <tr><td class="nowrap"><%= rule.position %></td>
                  <td class="nowrap"><%= rule.subject_type %></td>
                  <td class="nowrap mono"><%= rule.render %></td></tr>
              <% end %>
            </tbody>
          </table></div>
        <% else %><div class="empty-note">No rules — access is default deny.</div><% end %>

        <pre class="code"><code><%= doc %></code></pre>
        <div class="actions">
          <button type="button" class="btn sm" data-act="copy"
                  data-copy="<%= doc %>"
                  data-testid="policy-copy-<%= app.name %>">Copy policy</button>
          <a class="btn sm" href="<%= service_path(app) %>">Open service</a>
        </div>
        <p class="hint">Rule changes need a gateway restart; group membership changes are live. Deploy this document to <span class="mono"><%= gw.name %>.<%= gw.zone.name %></span> and restart the gateway to apply it.</p>
      </div>
    <% end %>
  <% end %>

  <div class="panel">
    <div class="panel-h"><h2>Test access</h2></div>
    <p class="sub">Pick a device and a service. The check runs the same rule walk the gateway performs: a revoked or pending device, a disabled owner or a disabled service deny; then the rules in order until one allows — otherwise default deny. This is a panel-side simulation of the gateway decision, not a probe of the running gateway.</p>
    <%= form_with url: "/policies/test", method: :post, html: { data: { testid: "test-access-form" } } do %>
      <div class="actions">
        <label for="test-access-device">Device</label>
        <select name="device_id" id="test-access-device" class="mono" data-testid="test-access-device">
          <option value="">choose…</option>
          <% @test_devices.each do |d| %>
            <option value="<%= d.id %>"><%= d.name %> (<%= d.status %>)</option>
          <% end %>
        </select>
        <label for="test-access-service">Service</label>
        <select name="service_id" id="test-access-service" class="mono" data-testid="test-access-service">
          <option value="">choose…</option>
          <% @test_apps.each do |gw, app| %>
            <option value="<%= app.id %>"><%= app.name %> (<%= gw.name %>.<%= gw.zone.name %>)</option>
          <% end %>
        </select>
        <button type="submit" class="btn sm primary">Check access</button>
      </div>
    <% end %>
    <div id="test-access-results" data-testid="test-access-results"></div>
    <%= render "test_result" if @test_result %>
  </div>
</div>
