<%# Slice 9b sub-slice 3: shared service form (new + edit). The gateway pick
    is only active on create; the name is fixed after create (it drives the
    gateway's service entry and the ztlp name <name>.<zone>). No NS publish
    happens on save — the rendered policy is deployed at gateway restart. %>
<%= form_with model: @service, class: "stack" do |f| %>
  <% if @service.errors.any? %>
    <div class="notice"><span class="err"><%= @service.errors.full_messages.to_sentence %></span></div>
  <% end %>
  <div class="panel">
    <div class="panel-b form-grid">
      <div class="field">
        <%= f.label :gateway_id, "Gateway" %>
        <%= f.select :gateway_id,
                     options_for_select(@gateways.map { |g| ["#{g.name}.#{g.zone.name} (#{g.kind})", g.id] }, @service.gateway_id),
                     { include_blank: false },
                     disabled: @service.persisted? %><p class="hint">Services on this gateway. On a <span class="mono">rust_listen</span> gateway the min-assurance floor is not enforced by the gateway; on an <span class="mono">elixir</span> gateway group, role and user rules never match a device. <a href="<%= new_gateway_path %>">New gateway</a></p>
      </div>
      <div class="field">
        <%= f.label :name %>
        <%= f.text_field :name, required: true, readonly: @service.persisted?,
                          pattern: "[a-z0-9]([a-z0-9-]*[a-z0-9])?",
                          class: "mono" %><p class="hint">Lowercase DNS label, fixed after create; the full name is <span class="mono">&lt;name&gt;.&lt;zone&gt;</span> and is the service entry the gateway allow-lists.</p>
      </div>
      <div class="field">
        <%= f.label :backend %><%= f.text_field :backend, class: "mono" %><p class="hint">host:port the gateway forwards to (optional http(s):// scheme).</p>
      </div>
      <div class="field"><%= f.label :protocol %><%= f.text_field :protocol, class: "mono" %></div>
      <div class="field">
        <%= f.label :min_assurance %><%= f.number_field :min_assurance, in: 1..4, step: 1, required: true %><p class="hint">Devices below this assurance get a warning from the panel's test-access; Rust gateways do not enforce a floor.</p>
      </div>
      <div class="field"><%= f.label :description %><%= f.text_field :description %></div>
      <% if @service.persisted? %>
        <%= f.fields_for :gateway do |g| %>
          <fieldset class="form-grid" data-gateway-fields>
            <legend>Gateway <span class="mono"><%= @service.gateway.ns_name %></span></legend>
            <div class="field"><%= g.label :host_note, "Runs on" %><%= g.text_field :host_note, maxlength: 200 %></div>
            <div class="field"><label class="check"><%= g.check_box :inject_headers %> Sign people in with ZTLP (signed X-ZTLP-* headers)</label></div>
            <div class="field">
              <%= g.label :policy_file, "Runs with a policy file" %>
              <%= g.select :policy_file, [ [ "Yes (--policy)", true ], [ "No: every enrolled device gets in", false ], [ "Unknown", "" ] ],
                           selected: @service.gateway.policy_file.nil? ? "" : @service.gateway.policy_file %>
            </div>
            <div class="field"><%= g.label :bind_port, "UDP port" %><%= g.number_field :bind_port, in: 1..65_535 %></div>
            <div class="field"><%= g.label :ns_server, "Name server" %><%= g.text_field :ns_server, class: "mono", placeholder: @service.gateway.zone.ns_addr %></div>
            <div class="field"><%= g.label :relay_addr, "Relay" %><%= g.text_field :relay_addr, class: "mono", placeholder: Array(@service.gateway.zone.relay_addrs).first %></div>
            <div class="field"><%= g.label :max_sessions %><%= g.number_field :max_sessions, in: 1..100_000 %></div>
            <div class="field"><label class="check"><%= g.check_box :punch %> NAT hole punching</label></div>
            <div class="field"><%= g.label :image_tag, "Gateway image" %><%= g.text_field :image_tag, class: "mono", placeholder: Gateway.default_image %></div>
            <div class="field"><%= g.label :subject_map_text, "Fallback subject map" %><%= g.text_area :subject_map_text, rows: 3, class: "mono", placeholder: "<64 hex noise key>=steve" %></div>
            <p class="hint">Changes here take effect when the gateway is reinstalled or restarted with the updated settings
              (the install script on the service page reflects them).</p>
          </fieldset>
        <% end %>
      <% end %>
      <div class="actions">
        <%= f.submit @service.persisted? ? "Save" : "Create service", class: "btn primary" %>
        <%= link_to "Cancel", @service.persisted? ? service_path(@service) : services_path, class: "btn" %>
      </div>
    </div>
  </div>
<% end %>
