# ZTLP Bootstrap Server — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# ── Required ──────────────────────────────────────────────
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(64)'
SECRET_KEY_BASE=

# ── Encryption (for SSH key storage at rest) ──────────────
# Generate each with: ruby -rsecurerandom -e 'puts SecureRandom.hex(16)'
# ⚠️  If not set, random keys are generated on startup — SSH keys in DB
#     will be unreadable after container restart!
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ── Optional ──────────────────────────────────────────────
# Port to expose (default: 3000)
# PORT=3000

# Path to ztlp CLI binary (default: ztlp, assumed in PATH)
# ZTLP_CLI_PATH=ztlp

# ActionCable adapter: async (default, no deps) or redis
# ACTION_CABLE_ADAPTER=async
# REDIS_URL=redis://localhost:6379/1

# ── NS admin-API client (NS-Bootstrap-sync feature, PR #97 + Phase 2) ──
#
# Bootstrap calls NS's /admin/records endpoint every 5 minutes to mirror
# device registrations into its own database. Set the secret + base URL.
#
# IMPORTANT: under NS Phase 2 tenant isolation, this secret is the TENANT
# secret. Each Bootstrap container gets ONE secret which NS uses to
# identify which tenant is calling (e.g. TRS, Acme Dental).
#
# Copy the matching ZTLP_NS_ADMIN_API_TENANT_<SLUG>_SECRET value from
# the NS .env into this single variable.
#
# See docs/operations/ns-admin-tenant-isolation.md for full deployment.

# Where to find NS's admin HTTP endpoint (port 9103 by convention)
# ZTLP_NS_ADMIN_BASE_URL=http://ztlp-ns:9103

# 64-char hex (32 raw bytes). Generate: openssl rand -hex 32
# ZTLP_NS_ADMIN_API_SECRET=

# Toggle the cron sync on/off. Default: false until tenant config is verified.
# ZTLP_NS_SYNC_ENABLED=false
