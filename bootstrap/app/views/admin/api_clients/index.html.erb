<div class="sm:flex sm:items-center sm:justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">API Clients</h1>
    <p class="mt-1 text-sm text-gray-500">
      ZTLP-secured allowlist for the
      <code class="bg-gray-100 px-1 rounded text-xs">/api/v1/*</code> namespace.
      No API keys — auth is per-zone HMAC. See
      <code class="bg-gray-100 px-1 rounded text-xs">docs/api_v1_ztlp_secured.md</code> for the contract.
    </p>
  </div>
  <div class="mt-4 sm:mt-0">
    <%= link_to new_admin_api_client_path, class: "inline-flex items-center rounded-md bg-ztlp-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-ztlp-700" do %>
      <span class="mr-1">+</span> New API Client
    <% end %>
  </div>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Zone</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Client name</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Last used</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Notes</th>
        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% if @api_clients.any? %>
        <% @api_clients.each do |client| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900"><%= client.zone %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900"><%= client.name %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if client.active %>
                <span class="inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-800">Active</span>
              <% else %>
                <span class="inline-flex items-center rounded-full bg-gray-200 px-2 py-0.5 text-xs font-medium text-gray-700">Inactive</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
              <%= client.last_used_at ? time_ago_in_words(client.last_used_at) + " ago" : "never" %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate" title="<%= client.notes %>"><%= client.notes %></td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <%= link_to "Edit", edit_admin_api_client_path(client), class: "text-ztlp-600 hover:text-ztlp-900" %>
              <% if client.active %>
                <%= button_to "Deactivate", deactivate_admin_api_client_path(client),
                      method: :post,
                      class: "ml-3 text-yellow-700 hover:text-yellow-900 bg-transparent border-0 p-0 underline cursor-pointer",
                      form: { class: "inline-block" } %>
              <% else %>
                <%= button_to "Reactivate", reactivate_admin_api_client_path(client),
                      method: :post,
                      class: "ml-3 text-green-700 hover:text-green-900 bg-transparent border-0 p-0 underline cursor-pointer",
                      form: { class: "inline-block" } %>
              <% end %>
              <%= button_to "Delete", admin_api_client_path(client),
                    method: :delete,
                    class: "ml-3 text-red-700 hover:text-red-900 bg-transparent border-0 p-0 underline cursor-pointer",
                    form: { data: { turbo_confirm: "Permanently delete API client #{client.zone}/#{client.name}? Prefer 'Deactivate' for a reversible kill switch." }, class: "inline-block" } %>
            </td>
          </tr>
        <% end %>
      <% else %>
        <tr><td colspan="6" class="px-6 py-12 text-center text-sm text-gray-500">
          No API clients yet. Click <strong>+ New API Client</strong> to authorize a system (e.g. Z2LS) for the v1 API.
        </td></tr>
      <% end %>
    </tbody>
  </table>
</div>
