<div class="mb-6">
  <h1 class="text-2xl font-bold text-gray-900">New Device Grant</h1>
  <p class="mt-1 text-sm text-gray-500">
    Network: <%= @network.name %>
    (<code class="font-mono text-xs"><%= @network.zone %></code>)
  </p>
</div>

<div class="bg-white shadow rounded-lg p-6">
  <%= form_with model: @grant, url: network_device_communication_grants_path(@network), local: true do |f| %>
    <% if @grant.errors.any? %>
      <div class="rounded-md bg-red-50 p-4 mb-4">
        <div class="text-sm text-red-700">
          <p class="font-medium"><%= pluralize(@grant.errors.count, "error") %> prevented save:</p>
          <ul class="list-disc pl-5 mt-2">
            <% @grant.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :source_device_id, "Source device (initiates)", class: "block text-sm font-medium text-gray-700" %>
        <%= f.collection_select :source_device_id, @devices, :id, :name,
              { include_blank: "Select source device..." },
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-ztlp-500 focus:ring-ztlp-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :target_device_id, "Target device (accepts)", class: "block text-sm font-medium text-gray-700" %>
        <%= f.collection_select :target_device_id, @devices, :id, :name,
              { include_blank: "Select target device..." },
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-ztlp-500 focus:ring-ztlp-500 sm:text-sm" %>
      </div>
    </div>

    <div class="mt-4">
      <%= f.label :notes, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :notes, rows: 2,
            placeholder: "e.g. allow monitoring agent to scrape Prometheus on the database host",
            class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-ztlp-500 focus:ring-ztlp-500 sm:text-sm" %>
    </div>

    <div class="mt-6 flex items-center justify-end space-x-3">
      <%= link_to "Cancel", network_device_communication_grants_path(@network),
            class: "text-sm text-gray-600 hover:text-gray-900" %>
      <%= f.submit "Create Grant",
            class: "inline-flex items-center rounded-md bg-ztlp-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-ztlp-700" %>
    </div>
  <% end %>
</div>
