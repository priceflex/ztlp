<div class="mb-6">
  <nav class="text-sm text-gray-500 mb-2">
    <%= link_to @network.name, @network, class: "hover:text-gray-700" %> /
    <%= link_to "Tokens", network_tokens_path(@network), class: "hover:text-gray-700" %> /
  </nav>
  <h1 class="text-2xl font-bold text-gray-900">Generate Enrollment Token</h1>
  <p class="text-sm text-gray-500 mt-1">
    Bind the token to either a specific device (by hostname) or a user (by username).
    Tokens that aren't bound stay anonymous and can't be tied back to a principal later.
  </p>
</div>

<div class="max-w-2xl">
  <%= form_with(url: network_tokens_path(@network), method: :post, class: "space-y-6") do |form| %>
    <%# Phase A — target_kind radio + conditional sub-forms %>
    <fieldset>
      <legend class="block text-sm font-medium text-gray-700">Bind to</legend>
      <div class="mt-2 space-y-2">
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="target_kind" value="device" id="target_kind_device"
                 class="h-4 w-4 border-gray-300 text-ztlp-600 focus:ring-ztlp-500"
                 checked>
          <span class="ml-2 text-sm text-gray-900">Device — bind by hostname (e.g. <code>alice-laptop</code>)</span>
        </label>
        <label class="flex items-center cursor-pointer">
          <input type="radio" name="target_kind" value="user" id="target_kind_user"
                 class="h-4 w-4 border-gray-300 text-ztlp-600 focus:ring-ztlp-500">
          <span class="ml-2 text-sm text-gray-900">User — bind by username (existing or new)</span>
        </label>
      </div>
    </fieldset>

    <%# Device sub-form %>
    <div id="device_fields" data-target-kind="device">
      <label for="computer_name" class="block text-sm font-medium text-gray-700">Computer name</label>
      <input type="text" name="computer_name" id="computer_name"
             placeholder="alice-laptop"
             pattern="[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?)*"
             title="DNS-label shape: lowercase letters/digits/hyphens, optional dotted suffix"
             class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border">
      <p class="mt-1 text-xs text-gray-500">RFC 1035 hostname shape. Stored as the token's <code>target_label</code>.</p>
    </div>

    <%# User sub-form %>
    <div id="user_fields" data-target-kind="user" style="display: none;">
      <% if @ztlp_users.any? %>
        <label for="ztlp_user_id" class="block text-sm font-medium text-gray-700">Existing user</label>
        <select name="ztlp_user_id" id="ztlp_user_id"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border">
          <option value="">— pick an existing user —</option>
          <% @ztlp_users.each do |u| %>
            <option value="<%= u.id %>"><%= u.name %><%= " (#{u.email})" if u.email.present? %></option>
          <% end %>
        </select>
      <% end %>

      <div class="mt-4 border-t pt-4">
        <p class="text-sm text-gray-700 mb-2">…or create a new user inline:</p>
        <label for="new_username" class="block text-sm font-medium text-gray-700">New username</label>
        <input type="text" name="new_username" id="new_username"
               placeholder="alice"
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border">

        <label for="new_email" class="block text-sm font-medium text-gray-700 mt-2">Email (optional)</label>
        <input type="email" name="new_email" id="new_email"
               placeholder="alice@example.com"
               class="mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border">
      </div>
    </div>

    <%# Advanced — collapsed by default %>
    <details class="border-t pt-4">
      <summary class="cursor-pointer text-sm font-medium text-gray-700">Advanced (expiry, max uses, notes)</summary>
      <div class="mt-4 space-y-4">
        <div>
          <%= form.label :expires_in, "Expires in", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :expires_in, [["1 hour", "1h"], ["6 hours", "6h"], ["24 hours", "24h"], ["7 days", "168h"], ["30 days", "720h"]], { selected: "24h" }, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border" %>
        </div>

        <div>
          <%= form.label :max_uses, "Maximum uses", class: "block text-sm font-medium text-gray-700" %>
          <%= form.number_field :max_uses, value: 1, min: 1, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border" %>
        </div>

        <div>
          <%= form.label :notes, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_area :notes, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm sm:text-sm px-3 py-2 border", placeholder: "Optional notes (e.g. 'For office laptops')" %>
        </div>
      </div>
    </details>

    <div class="flex items-center space-x-4">
      <%= form.submit "Generate Token", class: "rounded-md bg-ztlp-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-ztlp-500 cursor-pointer" %>
      <%= link_to "Cancel", network_tokens_path(@network), class: "text-sm text-gray-600 hover:text-gray-500" %>
    </div>
  <% end %>
</div>

<%# Tiny vanilla-JS toggle. No Stimulus dependency on purpose — this
    file ships into existing tenant containers without an asset
    pipeline rebuild. %>
<script>
  (function () {
    var radios = document.querySelectorAll('input[name="target_kind"]');
    var deviceFields = document.getElementById('device_fields');
    var userFields = document.getElementById('user_fields');

    function refresh() {
      var checked = document.querySelector('input[name="target_kind"]:checked');
      var kind = checked ? checked.value : 'device';
      deviceFields.style.display = kind === 'device' ? '' : 'none';
      userFields.style.display = kind === 'user' ? '' : 'none';
    }

    radios.forEach(function (r) { r.addEventListener('change', refresh); });
    refresh();
  })();
</script>
