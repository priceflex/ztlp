#!/bin/bash -e

# Ensure SECRET_KEY_BASE is set
if [ -z "$SECRET_KEY_BASE" ]; then
  echo "⚠️  SECRET_KEY_BASE not set — generating a random one for this session."
  echo "   Set SECRET_KEY_BASE in your environment for persistent sessions."
  export SECRET_KEY_BASE=$(ruby -rsecurerandom -e 'puts SecureRandom.hex(64)')
fi

# Set encryption keys from env or generate defaults (warns if not set)
if [ -z "$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY" ]; then
  echo "⚠️  ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY not set — using generated key."
  echo "   SSH keys in the database will NOT survive container rebuilds without setting this."
  export ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(ruby -rsecurerandom -e 'puts SecureRandom.hex(16)')
fi

if [ -z "$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY" ]; then
  export ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(ruby -rsecurerandom -e 'puts SecureRandom.hex(16)')
fi

if [ -z "$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT" ]; then
  export ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(ruby -rsecurerandom -e 'puts SecureRandom.hex(16)')
fi

# Use /data for SQLite if the volume is mounted
if [ -d "/data" ] && [ -w "/data" ]; then
  export DATABASE_PATH="${DATABASE_PATH:-/data/production.sqlite3}"
fi

# Prepare database (create + migrate)
./bin/rails db:prepare

# Seed built-in policy templates + the default admin record. This is
# idempotent thanks to find_or_create_by!, so it's safe to run on every
# container start.
./bin/rails db:seed

# If the launch app provisioned us with ZTLP_BOOTSTRAP_ADMIN_EMAIL, ensure
# that email is registered as a super_admin so the registering operator
# can log in immediately after onboarding completes. The password is
# left blank (the operator sets it via the first-login flow / ZTLP-
# native enrollment), but the user record exists.
if [ -n "$ZTLP_BOOTSTRAP_ADMIN_EMAIL" ]; then
  ./bin/rails runner "
    email = ENV['ZTLP_BOOTSTRAP_ADMIN_EMAIL'].to_s.downcase
    name  = ENV['ZTLP_BOOTSTRAP_ADMIN_NAME'].presence || 'Admin'
    pwd   = ENV['ZTLP_BOOTSTRAP_ADMIN_PASSWORD'].presence || SecureRandom.hex(16)
    u = AdminUser.find_or_initialize_by(email: email)
    u.name = name if u.name.blank?
    if u.new_record?
      u.password = pwd
      u.password_confirmation = pwd
    end
    u.role = 'super_admin'
    u.save!
    puts \"[entrypoint] super_admin ensured: #{email} (created? #{u.previously_new_record?})\"
  "
fi

# BS-PR-4: auto-create the Network row matching the zone the launch app
# provisioned us with, so the dashboard shows the network immediately
# without the operator having to click through a "create network"
# wizard. Idempotent — second boot onwards is a no-op. Failures are
# logged but do NOT block container start (Rails app should still come
# up so the operator can fix things via the UI).
./bin/rails ztlp:network:ensure_from_env || \
  echo "[entrypoint] WARN: ztlp:network:ensure_from_env failed; continuing boot"

# v0.30.2: auto-seed the per-tenant Network with the shared production
# NS+Relay machine rows. Token-mint requires at least one NS machine row;
# without this every tenant's first dashboard click on "Generate
# enrollment token" fails with "Network must have at least one NS
# machine". Idempotent — repeat boots are a no-op. Failures are logged
# but do NOT block container start.
./bin/rails ztlp:network:ensure_shared_machines || \
  echo "[entrypoint] WARN: ztlp:network:ensure_shared_machines failed; continuing boot"

# BS-PR-4: log whether the NS server (ZTLP_NS_SERVER) is reachable on
# UDP. Diagnostic only — bootstrap stays up either way. The result is
# visible in `docker logs ztlp-bootstrap-<slug>`.
./bin/rails ztlp:network:check_ns_reachability || \
  echo "[entrypoint] WARN: ztlp:network:check_ns_reachability failed; continuing boot"

# T8: NS → Bootstrap device sync. Background loop, 5-minute cadence, gated
# on ZTLP_NS_SYNC_ENABLED=true so test/dev images don't hammer NS. Output
# is teed to /rails/log/ns_sync.log for postmortem grepping. The `&`
# detaches so `exec` below still hands PID 1 to the Rails server.
#
# Hardening: the parent script runs with `set -e`. A tee failure inside the
# loop body would normally kill the background subshell and silently stop
# sync scheduling forever. We pre-create the log dir, fall back to no-tee
# logging if it's not writable, and run the inner loop with errexit
# disabled so a one-off rake failure doesn't take down the scheduler.
if [ "${ZTLP_NS_SYNC_ENABLED:-false}" = "true" ]; then
  mkdir -p /rails/log 2>/dev/null || \
    echo "[entrypoint] WARN: /rails/log not creatable; ns_sync.log will be skipped"
  (
    set +e
    while true; do
      if [ -w /rails/log ]; then
        bundle exec rake ztlp:ns:sync 2>&1 | tee -a /rails/log/ns_sync.log
      else
        bundle exec rake ztlp:ns:sync 2>&1
      fi
      sleep 300
    done
  ) &
  echo "[entrypoint] ZTLP_NS_SYNC_ENABLED=true — ztlp:ns:sync loop spawned (5min interval)"
else
  echo "[entrypoint] ZTLP_NS_SYNC_ENABLED is not 'true' — ztlp:ns:sync loop NOT spawned"
fi

exec "${@}"
