<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Task 6: the slim machine daemon the app installs via SMAppService
  (Contents/Library/LaunchDaemons/org.ztlp.machine.plist).

  Owns ONLY the machine bits (CA, /etc/resolver/ztlp, lo0 aliases), kept
  idempotent at boot by `ztlp agent machine-setup --boot`. No data plane —
  the data plane is the per-user agent, started by the app. This replaces the
  legacy full root agent (org.ztlp.agent), which the installer removes on
  upgrade (see AgentServiceInstaller.removeLegacyAgentDaemon).

  RunAtLoad + KeepAlive so the machine bits are always re-asserted; the
  command exits right after running the plan so KeepAlive cost is ~zero.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.ztlp.machine</string>
    <key>BundleProgram</key>
    <string>Contents/Helpers/ztlp</string>
    <key>ProgramArguments</key>
    <array>
        <string>ztlp</string>
        <string>agent</string>
        <string>machine-setup</string>
        <string>--boot</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Library/Application Support/ZTLP</string>
    </dict>
    <key>UserName</key>
    <string>root</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Library/Logs/ZTLP/machine.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/ZTLP/machine.stderr.log</string>
</dict>
</plist>
