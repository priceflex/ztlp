# Safe template for local ZTLP Launch testing.
# Copy to .env.local and edit locally. Never commit .env.local.

LAUNCH_PUBLIC_HOST=www.ztlp.net
LAUNCH_PORT=8080
LAUNCH_INSTANCE_BASE_PORT=39000
LAUNCH_INSTANCE_ROOT=./data/instances
LAUNCH_BOOTSTRAP_IMAGE=priceflex/ztlp-bootstrap:latest
LAUNCH_DEFAULT_ZONE_SUFFIX=ztlp

# For future email delivery of onboarding links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ztlp.net

# For future signed installer/download manifest.
ZTLP_DOWNLOAD_MANIFEST_URL=https://www.ztlp.net/downloads/manifest.json
