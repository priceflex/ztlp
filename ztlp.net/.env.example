# Safe template for local ZTLP Launch testing.
# Copy to .env.local and edit locally. Never commit .env.local.

# --- Public-facing addressing ---
# LAUNCH_PUBLIC_HOST is what we render into absolute URLs (claim links, etc.).
# When fronted by ngrok use the branded reserved domain.
LAUNCH_PUBLIC_HOST=www.ztlp.net

# --- Server bind ---
# LAUNCH_BIND_HOST=0.0.0.0 is required when ngrok runs with --network host.
# LAUNCH_PORT/LAUNCH_BIND_PORT — the WSGI app listens here on the host.
LAUNCH_BIND_HOST=0.0.0.0
LAUNCH_PORT=8080

# --- Per-zone provisioned bootstrap stacks ---
# Each onboarding claim spins up a bootstrap docker stack. Ports start at
# LAUNCH_INSTANCE_BASE_PORT and increment per instance.
LAUNCH_INSTANCE_BASE_PORT=39000
LAUNCH_INSTANCE_ROOT=./data/instances
LAUNCH_BOOTSTRAP_IMAGE=priceflex/ztlp-bootstrap:latest
LAUNCH_DEFAULT_ZONE_SUFFIX=ztlp

# --- Onboarding policy ---
# Set LAUNCH_REQUIRE_POW=0 to skip Proof-of-Work for onboarding (recommended
# for E2E tests; 1 enforces it for adversarial contexts).
LAUNCH_REQUIRE_POW=0
# Comma-separated referral codes that bypass POW + rate limiting and show
# the claim token directly. Used for trusted internal onboarding.
# Generate your own: openssl rand -hex 16 | tr -d '\n'
LAUNCH_REFERRAL_CODES=ZTLP-DEV-2026

# For future email delivery of onboarding links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ztlp.net

# For future signed installer/download manifest.
ZTLP_DOWNLOAD_MANIFEST_URL=https://www.ztlp.net/downloads/manifest.json

# ── NS admin API (Phase 2 tenant isolation — items #5 + #6) ──────
#
# The NS /admin/records endpoint supports per-tenant authentication and
# IP allow-listing. Each customer Bootstrap container gets its own
# secret bound to a zone glob and a CIDR list. NS identifies which
# tenant is calling from the signature and scopes the response.
#
# See docs/operations/ns-admin-tenant-isolation.md for the full guide.
#
# ── Tenant: TRS (operator-tenant, sees everything under *.trs.ztlp) ──
# ZTLP_NS_ADMIN_API_TENANT_TRS_SECRET=
# ZTLP_NS_ADMIN_API_TENANT_TRS_ZONE_GLOB=*.trs.ztlp
# ZTLP_NS_ADMIN_API_TENANT_TRS_CIDRS=172.18.0.0/16
#
# ── Tenant: Acme Dental (example customer; peer-deny with other tenants) ──
# ZTLP_NS_ADMIN_API_TENANT_ACME_DENTAL_SECRET=
# ZTLP_NS_ADMIN_API_TENANT_ACME_DENTAL_ZONE_GLOB=*.acme-dental.trs.ztlp
# ZTLP_NS_ADMIN_API_TENANT_ACME_DENTAL_CIDRS=172.20.0.0/16
#
# Slug rules: UPPERCASE alphanumeric + underscore. Lowercase env vars
# are ignored (forces explicit deployment contract).
#
# Zone-glob rules:
#   *.trs.ztlp     — matches host.trs.ztlp, host.sub.trs.ztlp (one+ segs)
#   trs.ztlp       — exact match only (bare zone)
#   *.foo.*        — REJECTED at boot (middle wildcards forbidden)
#
# CIDRs: comma-separated IPv4 (multi-CIDR supported for primary+backup)
#
# ── Legacy (transition mode, deprecate in Phase 3) ────────────────
# Kept during migration so Bootstrap containers that don't yet have a
# tenant entry continue working. Audit event :admin_api_legacy_global_secret
# fires whenever this path is used, so operators can grep migration progress.
# ZTLP_NS_ADMIN_API_SECRET=
#
# ── Rate limit (PR #97) ──────────────────────────────────────────
# Format: <count>/<window-seconds>. Default 12/60 (covers 5-min cron
# with retry headroom).
# ZTLP_NS_ADMIN_API_RATE_LIMIT=12/60
