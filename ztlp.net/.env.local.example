# Local-only environment for ztlp.net/bin/run-local-ngrok.
# Copy to .env.local and fill values. Never commit .env.local.

NGROK_AUTHTOKEN=
NGROK_DOMAIN=www.ztlp.net
BOOTSTRAP_URL=https://www.ztlp.net
ZTLP_BOOTSTRAP_UPSTREAM=3000

# Optional persistent Rails production secrets for local testing.
# If omitted, bootstrap/bin/docker-entrypoint generates throwaway values per container session.
# SECRET_KEY_BASE=
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
